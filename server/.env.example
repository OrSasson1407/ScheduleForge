# Copy to .env for local development (server/index.js loads these from the
# real environment; use `env $(cat .env | xargs) node index.js` or a tool
# like dotenv-cli to load this file, since the server itself does not read
# .env directly - only actual environment variables, so a hosting platform's
# own environment-variable settings work with no extra step).

# Required. A Postgres connection string. Locally:
#   docker run -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=scheduleforge -p 5432:5432 postgres:16-alpine
#   DATABASE_URL=postgres://postgres:dev@localhost:5432/scheduleforge
DATABASE_URL=postgres://postgres:dev@localhost:5432/scheduleforge

# Set to "disable" for a local database with no TLS at all (e.g. the docker
# run command above). Leave unset for a managed database, which needs TLS.
DATABASE_SSL=disable

# The web app's real origin once deployed, e.g. https://scheduleforge.example.com.
# Left unset (or "*"), every origin is allowed - fine for local development,
# wrong for anything else.
ALLOWED_ORIGIN=http://localhost:5173

# The password of the one bootstrap admin account, created the first time the
# server starts against a database with no admin yet. If this is not set, a
# random password is generated and printed to the server's own log exactly
# once - set this explicitly instead of relying on that for anything but a
# quick local trial.
ADMIN_PASSWORD=changeme123

# Set to "true" only for a classroom trial or a staging environment: seeds
# four accounts (admin/editor/teacher/student) with fixed, publicly-known
# passwords documented in the README. Never set this in production.
SEED_DEMO_ACCOUNTS=false

# The port the server listens on. Most platforms (Render included) set this
# for you; only needed locally if 8787 is taken.
PORT=8787

# Optional. A Sentry DSN for error reporting (server/errorTracking.js). Leave
# unset and errors are still logged as structured JSON, just not reported
# anywhere external.
SENTRY_DSN=

# Optional. Shares login/registration rate limiting across every instance of
# this server (server/rateLimit.js) instead of counting per-process. Only
# matters once you run more than one instance of the *HTTP* side of this
# server - which the collaboration relay's own in-memory room state does not
# currently support at all (render.yaml pins numInstances: 1), so leave this
# unset until that changes too.
REDIS_URL=
